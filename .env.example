# FastAPI
APP_NAME=Financial AI API
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (used by Docker Compose and Flyway)
POSTGRES_DB=financial_ai
POSTGRES_USER=financial_ai
POSTGRES_PASSWORD=financial_ai_local
POSTGRES_PORT=5432

# FastAPI connects from the host machine, so it uses localhost.
DATABASE_URL=postgresql+psycopg://financial_ai:financial_ai_local@localhost:5432/financial_ai
